# Agoranomos settings. ./agoranomos init copies this file to .env and generates every secret that is empty.
# .env holds secrets: never commit it, and keep a copy in a password manager. Without the Airflow and
# Metabase keys below, the connections saved in a restored backup cannot be decrypted.
# Write each setting as KEY=value on one line. After a value without quotes, a space and # start a comment, but after an empty value they become the value: put a comment on a line of its own. Put a value with spaces, a # or a $ in single quotes.
# docs/reference/configuration.md describes every setting.

# Docker Compose: the project name and the profiles that run. core is the whole stack in local mode,
# and demo adds the demo: on the first start it loads demo data and creates a demo dashboard in
# Metabase. Set COMPOSE_PROFILES=core to start without it. ai adds the container of the MCP servers
# of the warehouse and of Airflow, in local mode (ADR-0030); ./agoranomos ai warehouse|airflow on|off
# adds it and takes it out. server adds the proxy of server mode (ADR-0019), and ops the daily
# backups (ADR-0020); ./agoranomos init --server adds both and takes ai out.
COMPOSE_PROJECT_NAME=agoranomos
COMPOSE_PROFILES=core,demo,ai

# The Airflow executor. LocalExecutor runs tasks inside the scheduler container and needs no broker.
# For CeleryExecutor with separate workers, set COMPOSE_FILE=compose.yaml:compose.celery.yaml.
COMPOSE_FILE=compose.yaml

# The admin account of Airflow (user name admin) and Metabase, created on the first start.
AGORANOMOS_ADMIN_EMAIL=admin@example.com

# The folder for this deployment's own extensions (ADR-0013). Releases never overwrite it.
AGORANOMOS_EXTENSIONS_DIR=./extensions

# The currency in which the marts add up money across ad accounts (ADR-0025): spend_reporting and
# the other columns that end in _reporting. EUR or a currency of the reference rates of the ECB
# (ADR-0032). The rates of the demo cover USD and EUR only: another currency needs those of the
# ECB, which the DAG agoranomos_ecb_daily loads once it is unpaused in Airflow.
AGORANOMOS_REPORTING_CURRENCY=USD

# Ports on 127.0.0.1.
AIRFLOW_PORT=8080
METABASE_PORT=3000

# Server mode (ADR-0019): Caddy serves Metabase over HTTPS on ports 80 and 443, the only ports
# open to the network. ./agoranomos init --server <domain> turns it on: it adds the server and ops
# profiles and sets AGORANOMOS_SITE_URL=https://<domain> and AGORANOMOS_IPV6=true (IPv6 on the
# network of the stack, ADR-0023). Where Caddy gets the certificate: acme, from the ACME directory
# below, or internal, from its own authority, which no browser trusts (for tests).
AGORANOMOS_TLS=acme
# The ACME directory of Let's Encrypt. Its staging directory,
# https://acme-staging-v02.api.letsencrypt.org/directory, has higher rate limits, for trials.
AGORANOMOS_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# AI access in Metabase (ADR-0017): the highest level that this deployment allows, from off, which
# keeps the MCP server of Metabase off, through answers and explore to build, and the default level
# that every account gets, from answers up. An admin puts people above the default into the groups
# of the setup in Metabase, such as "Agoranomos: Builders". Two switches follow the level:
# METABASE_MCP turns the MCP server on, and METABASE_MCP_SQL the SQL that a client writes.
# ./agoranomos ai shows them, and ./agoranomos ai set <level> [--default <level>] writes all four.
# An upgrade of a deployment from before the levels gets off.
METABASE_AI_LEVEL=build
METABASE_AI_DEFAULT_LEVEL=explore
METABASE_MCP=true
METABASE_MCP_SQL=false

# The MCP servers of the warehouse (MCP Toolbox, as the read-only role ai_reader) and of Airflow
# (astro-airflow-mcp, read-only, as the Airflow user ai with the role Viewer), which an AI client on
# this machine starts with ./agoranomos mcp warehouse|airflow (ADR-0030). Local mode only.
# ./agoranomos ai warehouse|airflow on|off sets them, with the ai profile. An upgrade of a deployment
# from before them gets both off.
WAREHOUSE_MCP=true
AIRFLOW_MCP=true

# Google Ads (ADR-0032): the key of a service account of the Google Cloud project of this
# deployment, the JSON file that Google Cloud makes, as base64 on one line or as the JSON in single
# quotes, and the manager account through which the service account reaches the accounts, ten
# digits, or nothing when it is a user of each account. The DAG agoranomos_google_ads_daily loads
# the accounts of google_ads that extensions/model/clients.toml names. They stay commented out,
# as init would put a random secret into an empty setting: uncomment them to connect Google Ads
# (docs/how-to/connect-google-ads.md).
# GOOGLE_ADS_SERVICE_ACCOUNT_KEY=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Backups (ADR-0020): the folder that they go into, readable by its owner only, and, with the ops
# profile, which server mode turns on, the time of the daily backup in a time zone such as
# Europe/Berlin, and how many daily, weekly and monthly backups to keep. ./agoranomos backup takes
# one at any time.
AGORANOMOS_BACKUP_DIR=./backups
BACKUP_TIME=03:00
BACKUP_TZ=UTC
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3
# The user and group that write the backups, so that they belong to you: init puts in yours.
AGORANOMOS_UID=auto
AGORANOMOS_GID=auto

# How many Airflow tasks run at the same time. With LocalExecutor, each one is a process in the
# scheduler container, so more tasks need more memory there.
AIRFLOW_PARALLELISM=4

# With CeleryExecutor only: how many tasks one Airflow worker runs at a time.
AIRFLOW_WORKER_CONCURRENCY=4

# The memory limit of each service that runs all the time, in MiB (m) or GiB (g), measured on the
# demo (docs/reference/system-requirements.md). Raise the limit of a service that needs more.
WAREHOUSE_DB_MEMORY=384m
PLATFORM_DB_MEMORY=512m
AIRFLOW_APISERVER_MEMORY=512m
AIRFLOW_DAG_PROCESSOR_MEMORY=512m
AIRFLOW_TRIGGERER_MEMORY=512m
# The container that runs the Airflow tasks: the scheduler with LocalExecutor, the worker with
# CeleryExecutor. Heavier pipelines, or a higher AIRFLOW_PARALLELISM, need more.
AIRFLOW_TASKS_MEMORY=1280m
# Half of it goes to the heap of Java.
METABASE_MEMORY=2176m
# Server mode only: the proxy.
PROXY_MEMORY=256m
# With the ops profile: the backups.
BACKUP_MEMORY=256m
# With the ai profile: the MCP servers of the warehouse and of Airflow, for one session of a client.
AI_MEMORY=384m
# With CeleryExecutor only: the scheduler, which then runs no task, and the broker.
AIRFLOW_SCHEDULER_MEMORY=640m
BROKER_MEMORY=256m

# Secrets: leave them empty, and ./agoranomos init generates them. docs/reference/configuration.md says
# which of them can be changed later and how.
WAREHOUSE_POSTGRES_PASSWORD=
PLATFORM_POSTGRES_PASSWORD=
AIRFLOW_DB_PASSWORD=
METABASE_DB_PASSWORD=
METABASE_READER_PASSWORD=
WAREHOUSE_LOADER_PASSWORD=
WAREHOUSE_TRANSFORMER_PASSWORD=
BACKUP_DB_PASSWORD=
VALKEY_PASSWORD=
CELERY_RESULTS_DB_PASSWORD=
AI_READER_PASSWORD=
AIRFLOW_AI_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_ADMIN_PASSWORD=
METABASE_ENCRYPTION_KEY=
METABASE_SESSION_KEY=
METABASE_ADMIN_PASSWORD=
