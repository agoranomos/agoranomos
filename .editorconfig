root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# The documentation site nests a list item only when it is indented by four spaces.
[*.md]
indent_size = 4

[Makefile]
indent_style = tab

# caddy fmt indents the Caddyfile with tabs.
[Caddyfile]
indent_style = tab
