# Python and uv
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tool caches and reports
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Documentation build output and cache (Zensical)
site/
.cache/

# Environment files hold secrets: never commit them. .env.example is the template that ./agoranomos init copies.
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Machine-local Claude Code files
CLAUDE.local.md
.claude/settings.local.json

# A deployment's own extensions (ADR-0013): the folder belongs to the deployment, not to this repository.
/extensions/*
!/extensions/README.md

# The backups of a deployment (ADR-0020): they hold its data.
/backups/

# Local Compose overrides, for example published database ports for an IDE
compose.override.yaml

# dbt run by hand in dbt/
/dbt/target/
/dbt/logs/
/dbt/dbt_packages/
