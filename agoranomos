#!/bin/sh
# Agoranomos command line: set up, check and run the Docker Compose stack (ADR-0014).
# Usage: ./agoranomos <command> [options]; ./agoranomos help lists the commands.
# It needs only Docker and the standard tools of macOS, Linux and WSL2, so it stays POSIX sh.
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
ENV_FILE="$ROOT/.env"
ENV_EXAMPLE="$ROOT/.env.example"

# Preflight limits (ADR-0010, and ADR-0022 for the memory). Docker reports a little less memory than
# the machine or VM has, because the kernel keeps some for itself, so the memory limits sit slightly
# below 6 GB, 8 GB and 12 GB.
MIN_DOCKER_VERSION=25.0.0
MIN_COMPOSE_VERSION=2.24.0
MIN_MEMORY_MB=5632
RECOMMENDED_MEMORY_MB=7680
# The CeleryExecutor variant needs more: 12 GB as Docker reports it (ADR-0022).
RECOMMENDED_CELERY_MEMORY_MB=11776
MIN_CPUS=2
RECOMMENDED_CPUS=4
MIN_DISK_GB=10
RECOMMENDED_DISK_GB=20

# What up and status say when the backups are not fresh: the service is unhealthy, or the last good
# backup finished more than 26 hours (93,600 seconds, as postgres/backup.sh counts) ago.
NO_RECENT_BACKUP="no good backup in the last 26 hours"
BACKUP_FRESH_SECONDS=93600

# The state that problem and resource_problem work on. cmd_preflight resets it; it is set here so that
# the two functions also work when another command calls them.
problems=0
force=0

# The profile that compose adds to those of .env for one call (compose_with_profile sets it). It is
# set here, empty, so that a variable of the same name in the environment of the person never
# reaches Compose.
extra_profile=""

# The settings that init generates when they are empty.
SECRET_KEYS="WAREHOUSE_POSTGRES_PASSWORD PLATFORM_POSTGRES_PASSWORD AIRFLOW_DB_PASSWORD
METABASE_DB_PASSWORD METABASE_READER_PASSWORD WAREHOUSE_LOADER_PASSWORD
WAREHOUSE_TRANSFORMER_PASSWORD BACKUP_DB_PASSWORD VALKEY_PASSWORD AIRFLOW_FERNET_KEY
AIRFLOW_JWT_SECRET AIRFLOW_API_SECRET_KEY AIRFLOW_ADMIN_PASSWORD METABASE_ENCRYPTION_KEY
METABASE_SESSION_KEY METABASE_ADMIN_PASSWORD"

say() { printf '%s\n' "$*"; }
warn() { printf '%s %s\n' "$(paint amber 'warning:' 2)" "$*" >&2; }
error_line() { printf '%s %s\n' "$(paint ember 'error:' 2)" "$*" >&2; }
die() {
  error_line "$*"
  exit 1
}

# Colors. A stream gets them only when it is a terminal that has color: the standard output and
# the standard error are decided one by one, so that an error on a terminal still has its color
# while the standard output goes into a pipe, and the other way round. Neither gets any when NO_COLOR
# is set to a value that is not empty (https://no-color.org) or when TERM is dumb or not set.
# The colors must read on a dark and on a light terminal, so only the top cell of the mark is the
# bright amber of the brand, and the name and the two bottom cells use the own text color of the
# terminal. The messages use mid-tones of the hues of the brand (amber, ok for mint, ember and mute
# for gray) that keep 4.5:1 or more against both black and white in 24-bit color.

# How many colors the terminal has: 24 (24-bit color, when COLORTERM says so), 256, 8 or 0.
color_depth() {
  case "${COLORTERM:-}" in
    truecolor | 24bit)
      printf '24'
      return 0
      ;;
  esac
  count=$(tput colors 2> /dev/null) || count=0
  if [ "$count" -ge 256 ] 2> /dev/null; then
    printf '256'
  elif [ "$count" -ge 8 ] 2> /dev/null; then
    printf '8'
  else
    printf '0'
  fi
}

# Set colors_out and colors_err to how many colors the standard output and the standard error may
# use: 0 (none), 8, 256 or 24. It sets variables rather than printing numbers, because the tests
# for a terminal fail inside $(...), where the standard output is a pipe. main runs it once, before
# anything is printed; paint reads the variables, also inside $(...).
detect_colors() {
  colors_out=0
  colors_err=0
  if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = dumb ]; then
    return 0
  fi
  if [ -t 1 ] || [ -t 2 ]; then
    depth=$(color_depth)
    if [ -t 1 ]; then colors_out=$depth; fi
    if [ -t 2 ]; then colors_err=$depth; fi
  fi
}

# Print the escape sequence of the style $1 for a terminal with $2 colors (8, 256 or 24): mark,
# text, amber, ok, ember, mute or bold. mark is the bright amber of the brand, for the top cell of
# the mark only, and text is the own text color of the terminal. The other colors are mid-tones of
# the hues of the brand, for words that people read. The 24-bit codes keep at least 4.5:1 against
# both black and white; the 256-color codes are the nearest entries of the xterm palette that do
# (amber has none with its hue: 130 has 4.46:1 against black). A terminal with 8 colors gets the
# nearest basic color, and dim for mute; its theme sets those colors for its own background.
sgr() {
  case "$1" in
    bold)
      printf '\033[1m'
      return 0
      ;;
    text)
      printf '\033[39m'
      return 0
      ;;
  esac
  case "$2:$1" in
    24:mark) printf '\033[38;2;255;176;32m' ;;
    24:amber) printf '\033[38;2;157;108;20m' ;;
    24:ok) printf '\033[38;2;37;133;91m' ;;
    24:ember) printf '\033[38;2;215;62;24m' ;;
    24:mute) printf '\033[38;2;118;116;126m' ;;
    256:mark) printf '\033[38;5;214m' ;;
    256:amber) printf '\033[38;5;130m' ;;
    256:ok) printf '\033[38;5;29m' ;;
    256:ember) printf '\033[38;5;131m' ;;
    256:mute) printf '\033[38;5;243m' ;;
    8:mark | 8:amber) printf '\033[33m' ;;
    8:ok) printf '\033[32m' ;;
    8:ember) printf '\033[31m' ;;
    8:mute) printf '\033[2m' ;;
  esac
}

# Print the text $2 without a newline, in the styles $1 (words, such as 'text bold') when the stream
# $3 (1 for the standard output, 2 for the standard error) may have color, and then a reset, so that
# the colors never leak into what follows. The text is the same without the colors. Name the stream
# that the text will be printed to: paint does not print to it, it only decides about the colors.
paint() {
  case "$3" in
    2) depth=${colors_err:-0} ;;
    *) depth=${colors_out:-0} ;;
  esac
  if [ "$depth" -eq 0 ]; then
    printf '%s' "$2"
    return 0
  fi
  for style in $1; do
    sgr "$style" "$depth"
  done
  printf '%s\033[0m' "$2"
}

# The header that up and help print: the mark of three cells, which together read as the letter A,
# and the name. The cells are the Unicode full block (U+2588) also in the plain text, so that the
# colored output without its escape codes is the plain output; a terminal or a log that does not
# use UTF-8 shows them wrongly. The top cell is bright amber, the two bottom ones and the name are
# in the own text color of the terminal, the name in bold, and the tagline is mute.
print_banner() {
  printf '  %s\n' "$(paint mark '██' 1)"
  printf '%s  %s  %s\n' "$(paint text '██' 1)" "$(paint text '██' 1)" "$(paint 'text bold' agoranomos 1)"
  printf '        %s\n\n' "$(paint mute 'marketing bi, out of the box.' 1)"
}

# Run docker compose in the checkout, where Compose finds compose.yaml and .env. Compose reads
# COMPOSE_PROJECT_NAME, COMPOSE_PROFILES and COMPOSE_FILE from its environment before it reads .env,
# so a variable of the same name that is still exported in this shell, from another project, would
# win over .env. These three therefore come from .env here, with the defaults of .env.example. The
# files and the profiles reach Compose through these variables, never through -f and --profile
# options, so this script and a plain docker compose in the checkout work on the same stack. A
# command that must reach a service of a profile that .env does not list sets extra_profile
# (compose_with_profile). The one exception is AGORANOMOS_IMAGES, the images of the checkout, which
# the backup service writes into each manifest (ADR-0020): a plain docker compose up gives that
# service an empty list, so the next ./agoranomos up recreates it, and its backups record no
# images until then. A call of exec or run passes the standard input of this script to the command in
# the container, also with -T, so a script that is fed to the shell (ssh host bash -s) would lose
# its next lines to it: every such call reads /dev/null, but the one that copies a dump into a
# container, which reads the file.
compose() {
  (
    cd "$ROOT" || exit 1
    COMPOSE_PROJECT_NAME=$(setting COMPOSE_PROJECT_NAME agoranomos)
    COMPOSE_PROFILES=$(setting COMPOSE_PROFILES core,demo)
    if [ -n "${extra_profile:-}" ]; then
      COMPOSE_PROFILES=$(with_profiles "$COMPOSE_PROFILES" "$extra_profile")
    fi
    COMPOSE_FILE=$(setting COMPOSE_FILE compose.yaml)
    # The images of the checkout, which the backup service writes into each backup (ADR-0020).
    AGORANOMOS_IMAGES=$(image_refs | tr '\n' ' ')
    AGORANOMOS_IMAGES=${AGORANOMOS_IMAGES% }
    export COMPOSE_PROJECT_NAME COMPOSE_PROFILES COMPOSE_FILE AGORANOMOS_IMAGES
    docker compose "$@"
  )
}

# Print the value of a setting in .env, or nothing when it is not set. It reads lines of the form
# KEY=value as Docker Compose does (compose-go 2.16.1, as of October 2026): the last line that sets
# the key counts, the blanks after the = do not, a value in single or double quotes is what is
# between them, and a value without quotes ends before " #", which starts a comment, and without the
# blanks at its end, the carriage return of a .env that Windows saved among them. After an empty
# value " #" starts no comment, as in Compose. It does not read "export KEY=v" or blanks around the
# =, and it does not expand $ or read escapes in quotes. The key reaches awk in its environment, not
# in its program.
env_get() {
  [ -f "$ENV_FILE" ] || return 0
  ENV_GET_KEY=$1 awk -v squote="'" '
    BEGIN { key = ENVIRON["ENV_GET_KEY"] "="; found = 0 }
    index($0, key) == 1 { value = substr($0, length(key) + 1); found = 1 }
    END {
      if (!found) exit
      sub(/^[ \t\r\v\f]+/, "", value)
      quote = substr(value, 1, 1)
      if (quote == "\"" || quote == squote) {
        rest = substr(value, 2)
        end = index(rest, quote)
        if (end > 0) {
          printf "%s", substr(rest, 1, end - 1)
          exit
        }
      }
      cut = index(value, " #")
      if (cut > 0) value = substr(value, 1, cut - 1)
      sub(/[ \t\r\v\f]+$/, "", value)
      printf "%s", value
    }
  ' "$ENV_FILE"
}

# Print the size of a memory limit in bytes, as Compose reads it: a number with the unit k, m or
# g, in either case and with b or ib after it, each a power of 1024. Print nothing for anything
# else, such as a number without a unit, which Compose would read as bytes.
memory_bytes() {
  printf '%s\n' "$1" | awk '
    /^[0-9]+(\.[0-9]+)?[kKmMgG]([iI]?[bB])?$/ {
      match($0, /[kKmMgG]/)
      unit = tolower(substr($0, RSTART, 1))
      factor = unit == "k" ? 1024 : (unit == "m" ? 1048576 : 1073741824)
      printf "%.0f\n", substr($0, 1, RSTART - 1) * factor
    }'
}

# Print a setting from .env, or the default when it is not set or empty.
setting() {
  setting_value=$(env_get "$1")
  printf '%s' "${setting_value:-$2}"
}

# Set a setting in .env: replace the first line that sets it and drop the later ones, or add a line at
# the end. The key and the value reach awk in its environment, not in -v options: -v interprets
# backslash escapes, so a value such as C:\data would be corrupted and \n would start a new line, and
# the arguments of a process, a secret among them, can be read by other users with ps. A value with a
# line break is refused: .env keeps one setting on a line, and the second line would be a setting of its own.
env_set() {
  newline='
'
  case "$2" in
    *"$newline"*) die "the value of $1 has more than one line: .env keeps each setting on one line" ;;
  esac
  env_tmp="$ENV_FILE.tmp.$$"
  if (
    umask 077
    ENV_SET_KEY=$1 ENV_SET_VALUE=$2 awk '
      BEGIN { key = ENVIRON["ENV_SET_KEY"]; value = ENVIRON["ENV_SET_VALUE"] }
      index($0, key "=") == 1 { if (!done) print key "=" value; done = 1; next }
      { print }
      END { if (!done) print key "=" value }
    ' "$ENV_FILE" > "$env_tmp"
  ) && mv "$env_tmp" "$ENV_FILE"; then
    return 0
  fi
  rm -f "$env_tmp"
  die "could not update $ENV_FILE"
}

random_alnum() { LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c "$1"; }
random_from() { LC_ALL=C tr -dc "$1" < /dev/urandom | head -c 1; }

# Admin passwords end with an upper-case letter, a lower-case letter and a digit: Metabase needs a digit.
random_password() {
  printf '%s%s%s%s' "$(random_alnum 29)" "$(random_from 'A-Z')" "$(random_from 'a-z')" "$(random_from '0-9')"
}

# A Fernet key for Airflow: 32 random bytes in URL-safe base64.
fernet_key() { head -c 32 /dev/urandom | base64 | tr '+/' '-_'; }

generate_secret() {
  case "$1" in
    AIRFLOW_FERNET_KEY) fernet_key ;;
    AIRFLOW_ADMIN_PASSWORD | METABASE_ADMIN_PASSWORD) random_password ;;
    AIRFLOW_JWT_SECRET | AIRFLOW_API_SECRET_KEY | METABASE_ENCRYPTION_KEY | METABASE_SESSION_KEY)
      random_alnum 64
      ;;
    *) random_alnum 32 ;;
  esac
}

# The absolute path of a folder that a setting names, as Compose reads it for a bind mount: an
# absolute path stays, a leading ~ is the home folder of the user, and a relative path starts at the
# checkout.
folder_path() {
  # shellcheck disable=SC2088 # a literal ~ in a value of .env, which no shell has expanded
  case "$1" in
    /*) printf '%s' "$1" ;;
    '~') printf '%s' "${HOME%/}" ;;
    '~/'*) printf '%s/%s' "${HOME%/}" "${1#\~/}" ;;
    *) printf '%s/%s' "$ROOT" "${1#./}" ;;
  esac
}

# True when $1 is a value that Compose reads as a path for a bind mount: absolute, or starting with
# ., .. or ~. Anything else, such as backups, it reads as the name of a volume.
is_folder_path() {
  # shellcheck disable=SC2088 # a literal ~ in a value of .env, which no shell has expanded
  case "$1" in
    /* | . | .. | ./* | ../* | '~' | '~/'*) return 0 ;;
  esac
  return 1
}

# The absolute path of the extensions folder (ADR-0013).
extensions_path() {
  folder_path "$(setting AGORANOMOS_EXTENSIONS_DIR ./extensions)"
}

# The images of the checkout, one reference to a line, sorted: the image: lines of the Compose
# files and the FROM lines of the Dockerfiles of the images that the stack builds, without those
# built images. A backup records them, and restore compares them.
image_refs() {
  for image_file in compose.yaml compose.celery.yaml airflow/Dockerfile caddy/Dockerfile; do
    [ -f "$ROOT/$image_file" ] || continue
    sed -n -e 's/^[[:space:]]*image:[[:space:]]*\([^[:space:]]*\).*/\1/p' \
      -e 's/^FROM[[:space:]][[:space:]]*\([^[:space:]]*\).*/\1/p' "$ROOT/$image_file"
  done | grep -v ':local$' | LC_ALL=C sort -u
}

# The absolute path of the backups folder (ADR-0020).
backups_path() {
  folder_path "$(setting AGORANOMOS_BACKUP_DIR ./backups)"
}

# Print a field of a JSON file that postgres/backup.sh wrote, which has one field to a line.
json_field() {
  [ -f "$1" ] || return 0
  sed -n "s/^  \"$2\": \"\{0,1\}\([^\",]*\)\"\{0,1\},\{0,1\}\$/\1/p" "$1"
}

# True when the container of the service $1 runs.
running_service() {
  compose ps --all --format '{{.Service}}|{{.State}}|{{.Health}}|{{.ExitCode}}' 2> /dev/null |
    grep -q "^$1|running|"
}

# True when .env runs the backup service: COMPOSE_PROFILES lists ops (ADR-0020).
ops_mode() {
  case ",$(setting COMPOSE_PROFILES core,demo)," in
    *,ops,*) return 0 ;;
  esac
  return 1
}

# Print what is wrong with the user that the backups are written as, or nothing. Each of the user ID
# and the group ID must be a number, of digits only; a user ID of zeros only, such as 0 or 00, which
# Docker reads as 0, is root.
backup_user_problem() {
  backup_uid=$(env_get AGORANOMOS_UID)
  backup_gid=$(env_get AGORANOMOS_GID)
  case "$backup_uid" in
    '' | *[!0-9]*) backup_uid_problem=numbers ;;
    *[!0]*) backup_uid_problem="" ;;
    *) backup_uid_problem=root ;;
  esac
  case "$backup_gid" in
    '' | *[!0-9]*) backup_gid_problem=numbers ;;
    *) backup_gid_problem="" ;;
  esac
  if [ "$backup_uid_problem" = root ]; then
    printf '%s' "AGORANOMOS_UID in .env is 0: the backup service would run as root, and the backups would belong to root. Run ./agoranomos as the user who owns the checkout, with AGORANOMOS_UID=auto and AGORANOMOS_GID=auto in .env, and run ./agoranomos init"
  elif [ "$backup_uid_problem" = numbers ] || [ "$backup_gid_problem" = numbers ]; then
    printf '%s' "AGORANOMOS_UID and AGORANOMOS_GID in .env must be numbers: set them to auto and run ./agoranomos init, which puts in yours"
  fi
}

# Make the backups folder, open to its owner only (ADR-0020). Docker would create a missing one as
# root, and on Linux nobody but root could then use it.
make_backups_folder() {
  backups=$(backups_path)
  mkdir -p "$backups" || die "could not create the backups folder $backups"
  chmod 700 "$backups" ||
    die "could not make the backups folder $backups open to its owner only: it must belong to you"
}

# True when the backups folder exists and does not belong to AGORANOMOS_UID, the user that the
# backup service and the container of ./agoranomos backup run as. It sets owned_folder and
# folder_owner. A folder that does not exist yet has no owner to compare: init makes it.
backup_folder_foreign() {
  owned_folder=$(backups_path)
  [ -d "$owned_folder" ] || return 1
  # ls -ldn gives the numeric owner of one path on Linux and macOS alike; stat has other options on
  # each. The slash after the path makes ls look at the folder that a link points to, which is the
  # folder that the service writes into, and not at the link.
  # shellcheck disable=SC2012
  folder_owner=$(ls -ldn "$owned_folder/" | awk '{ print $3 }')
  # The IDs are numbers, so that 0501 is 501.
  owner_number=$(printf '%s' "$folder_owner" | sed 's/^0*\([0-9]\)/\1/')
  uid_number=$(env_get AGORANOMOS_UID | sed 's/^0*\([0-9]\)/\1/')
  [ "$owner_number" != "$uid_number" ]
}

# On Linux a bind mount keeps the owner of the host, so the backup service cannot write into a
# folder of mode 700 that another user owns; Docker Desktop maps the owner of a shared folder.
backups_folder_unwritable() {
  printf '%s' "the backup service (AGORANOMOS_UID=$(env_get AGORANOMOS_UID)) cannot write $owned_folder, which belongs to UID $folder_owner: set AGORANOMOS_UID and AGORANOMOS_GID in .env to the user and the group that own the folder, or give the folder to UID $(env_get AGORANOMOS_UID) with chown"
}

# True when the running backup service has the backups folder and the user that .env names now. A
# service made before a change of AGORANOMOS_BACKUP_DIR or AGORANOMOS_UID keeps the old ones until
# up makes it again, and a check in it would read another folder than the one that restore copies
# from. The mount of /backups and the user come from docker inspect of its container.
backup_service_current() {
  service_container=$(compose ps --quiet backup 2> /dev/null) || return 1
  [ -n "$service_container" ] || return 1
  service_has=$(docker inspect --format '{{.Config.User}}|{{range .Mounts}}{{if eq .Destination "/backups"}}{{.Source}}{{end}}{{end}}' "$service_container" 2> /dev/null) || return 1
  [ "$service_has" = "$(env_get AGORANOMOS_UID):$(env_get AGORANOMOS_GID)|$(backups_path)" ]
}

# True when .env runs server mode: COMPOSE_PROFILES lists server (ADR-0011, ADR-0019).
server_mode() {
  case ",$(setting COMPOSE_PROFILES core,demo)," in
    *,server,*) return 0 ;;
  esac
  return 1
}

# True when $1 is a domain name of two labels or more, of letters, digits and hyphens, whose last
# label starts with a letter: no scheme, port or path, and not an IP address. grep reads lines, so
# an argument of more than one line is refused first: its other lines could be anything.
valid_domain() {
  domain_newline='
'
  case "$1" in
    *"$domain_newline"*) return 1 ;;
  esac
  printf '%s\n' "$1" |
    grep -Eq '^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$'
}

# True when Let's Encrypt can issue a certificate for the domain $1: not localhost or a name under
# .localhost, .test, .example or .invalid, which RFC 6761 keeps for local use and tests, and not a
# name under .local, .internal or home.arpa (or home.arpa itself), which Caddy serves only with its
# own authority. DNS names are not case-sensitive, so the name is folded to lower case first, in
# the C locale, where only A to Z change.
public_name() {
  public_lower=$(printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]')
  case "$public_lower" in
    localhost | *.localhost | *.test | *.example | *.invalid | *.local | *.internal | home.arpa | *.home.arpa)
      return 1
      ;;
  esac
  return 0
}

# Print the comma-separated list of profiles $1 with each profile of the other arguments added,
# once, at its end.
with_profiles() {
  profile_list=$1
  shift
  for profile in "$@"; do
    case ",$profile_list," in
      *,"$profile",*) ;;
      *) profile_list="${profile_list:+$profile_list,}$profile" ;;
    esac
  done
  printf '%s' "$profile_list"
}

cmd_init() {
  server_domain="" server_asked=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --server)
        [ "$#" -ge 2 ] || die "--server needs the domain name of the server, such as --server bi.example.com"
        server_domain=$2 server_asked=1
        shift 2
        ;;
      *) die "unknown option of init: $1 (init takes --server <domain>)" ;;
    esac
  done
  if [ "$server_asked" -eq 1 ] && ! valid_domain "$server_domain"; then
    die "not a domain name: $server_domain. Write the name alone, such as bi.example.com: without https://, a port or a path, and not an IP address, which gets no certificate"
  fi
  [ -f "$ENV_EXAMPLE" ] || die "$ENV_EXAMPLE is missing: run ./agoranomos from an Agoranomos checkout"
  if [ ! -f "$ENV_FILE" ]; then
    (umask 077 && cp "$ENV_EXAMPLE" "$ENV_FILE")
    say "Created .env from .env.example."
  fi
  chmod 600 "$ENV_FILE"
  # Add the settings that .env.example has and .env does not, for example after an upgrade.
  added=""
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '' | '#'*) continue ;; esac
    key=${line%%=*}
    if ! grep -q "^$key=" "$ENV_FILE"; then
      [ -z "$(tail -c 1 "$ENV_FILE")" ] || printf '\n' >> "$ENV_FILE"
      printf '%s\n' "$line" >> "$ENV_FILE"
      added="$added $key"
    fi
  done < "$ENV_EXAMPLE"
  [ -z "$added" ] || say "Added new settings to .env:$added"
  generated=""
  for key in $SECRET_KEYS; do
    if grep -q "^$key=" "$ENV_FILE" && [ -z "$(env_get "$key")" ]; then
      secret=$(generate_secret "$key") || secret=""
      [ -n "$secret" ] || die "could not generate a value for $key: check that /dev/urandom is readable and that tr, head and base64 are installed"
      env_set "$key" "$secret"
      generated="$generated $key"
    fi
  done
  if [ -n "$generated" ]; then
    say "Generated secrets in .env:$generated"
    say "Keep a copy of .env in a password manager: a restored backup needs its keys to decrypt the saved connections."
  fi
  # The user and the group that write the backups: those of the user who runs init (ADR-0020).
  if [ "$(env_get AGORANOMOS_UID)" = auto ]; then env_set AGORANOMOS_UID "$(id -u)"; fi
  if [ "$(env_get AGORANOMOS_GID)" = auto ]; then env_set AGORANOMOS_GID "$(id -g)"; fi
  make_backups_folder
  mkdir -p "$(extensions_path)/dags" "$(extensions_path)/metadata"
  if [ "$server_asked" -eq 1 ]; then
    # A line is written only when its value changes, so that running init --server again changes
    # nothing, also in a .env that a person edited: a line with quotes or a comment stays as it is.
    [ "$(env_get AGORANOMOS_SITE_URL)" = "https://$server_domain" ] ||
      env_set AGORANOMOS_SITE_URL "https://$server_domain"
    current_profiles=$(setting COMPOSE_PROFILES core,demo)
    server_profiles=$(with_profiles "$current_profiles" server ops)
    [ "$server_profiles" = "$current_profiles" ] || env_set COMPOSE_PROFILES "$server_profiles"
    # Metabase on the internet (ADR-0019): passwords of at least 15 characters, and a sign-out after
    # 24 hours without activity. A value that a person set stays.
    [ -n "$(env_get METABASE_PASSWORD_COMPLEXITY)" ] || env_set METABASE_PASSWORD_COMPLEXITY strong-enough
    [ -n "$(env_get METABASE_SESSION_TIMEOUT)" ] ||
      env_set METABASE_SESSION_TIMEOUT "'{\"amount\":24,\"unit\":\"hours\"}'"
    # IPv6 on the network of the stack, so that Metabase sees the address of each IPv6 client
    # (ADR-0023). A value that a person set stays.
    [ -n "$(env_get AGORANOMOS_IPV6)" ] || env_set AGORANOMOS_IPV6 true
    say "Server mode is on: Metabase is to be at https://$server_domain, with a backup every day at $(setting BACKUP_TIME 03:00) $(setting BACKUP_TZ UTC) into $(backups_path). Point the A record of $server_domain at this server, then run ./agoranomos up."
    say "If this Metabase was set up before this release, its public links stay as they were: check Admin > Settings > Public sharing."
    if ! public_name "$server_domain" && [ "$(setting AGORANOMOS_TLS acme)" != internal ]; then
      say "$server_domain is not a name that gets a certificate of Let's Encrypt: for a test, set AGORANOMOS_TLS=internal in .env, or ./agoranomos up stops on it."
    fi
  fi
}

# True when version $1 is at least version $2. A leading v and suffixes such as -rc1 are ignored.
version_ge() {
  left=${1#v} right=${2#v}
  while [ -n "$left$right" ]; do
    left_part=${left%%.*} right_part=${right%%.*}
    left_part=${left_part%%[!0-9]*} right_part=${right_part%%[!0-9]*}
    if [ "${left_part:-0}" -gt "${right_part:-0}" ]; then return 0; fi
    if [ "${left_part:-0}" -lt "${right_part:-0}" ]; then return 1; fi
    case "$left" in *.*) left=${left#*.} ;; *) left="" ;; esac
    case "$right" in *.*) right=${right#*.} ;; *) right="" ;; esac
  done
  return 0
}

problem() {
  error_line "$*"
  problems=$((problems + 1))
}

# A problem with resources: --force turns it into a warning.
resource_problem() {
  if [ "$force" -eq 1 ]; then
    warn "$* (ignored: --force)"
  else
    problem "$*"
  fi
}

# The images need x86-64-v2 on x86-64 hardware. Docker Desktop hides the flags of its VM, so on
# macOS and Windows the check is skipped. AGORANOMOS_CPUINFO is a hook for the tests: it names a file
# to read instead of /proc/cpuinfo.
check_x86_64_v2() {
  cpuinfo=${AGORANOMOS_CPUINFO:-/proc/cpuinfo}
  [ -r "$cpuinfo" ] || return 0
  flags=" $(grep -m 1 '^flags' "$cpuinfo" | sed 's/^flags[[:space:]]*:[[:space:]]*//') "
  missing=""
  for flag in cx16 lahf_lm popcnt pni sse4_1 sse4_2 ssse3; do
    case "$flags" in *" $flag "*) ;; *) missing="$missing $flag" ;; esac
  done
  [ -z "$missing" ] || problem "this x86-64 CPU lacks$missing, which x86-64-v2 needs"
}

# Print, one per line, the tools that can find out whether a port is in use and are installed, in the
# order to ask them: ss (Linux and WSL2), netstat (macOS, BSD, and Linux without iproute2) and lsof. No
# tool sees every listener: without privileges lsof lists only the sockets of the current user, so it
# misses a port that another user holds, such as docker-proxy of another stack, and netstat has been
# seen to list no listener at all in some process contexts on macOS. So port_in_use asks all of them.
# AGORANOMOS_PORT_TOOLS is a hook for the tests: a list of tools to try instead of these three, in that
# order (empty: none).
port_tools() {
  for candidate in ${AGORANOMOS_PORT_TOOLS-ss netstat lsof}; do
    if command -v "$candidate" > /dev/null 2>&1; then
      printf '%s\n' "$candidate"
    fi
  done
}

# True when any installed tool lists a listener on TCP port $1: the tools are asked in order, and the
# search stops at the first that finds one. The whole port number has to match: 8080 is not 18080.
# It is false when no tool lists a listener, which includes the cases that no tool is installed
# (cmd_preflight warns about that) and that a tool fails, because then nothing can be said. netstat
# runs with LC_ALL=C because net-tools translates the names of the states. lsof counts only when it
# prints its COMMAND header, which it does when it finds a listener: the lsof of busybox ignores its
# options, lists all open files and exits 0, so its exit status alone would make every port busy.
port_in_use() {
  for port_tool_name in $(port_tools); do
    case "$port_tool_name" in
      ss)
        ss -ltn 2> /dev/null | awk -v port="$1" '
          $1 == "LISTEN" { n = split($4, parts, ":"); if ((parts[n] "") == (port "")) found = 1 }
          END { exit !found }'
        ;;
      netstat)
        LC_ALL=C netstat -an 2> /dev/null | awk -v port="$1" '
          $1 ~ /^tcp/ && $NF == "LISTEN" {
            n = split($4, parts, /[.:]/)
            if ((parts[n] "") == (port "")) found = 1
          }
          END { exit !found }'
        ;;
      lsof) lsof -nP -iTCP:"$1" -sTCP:LISTEN 2> /dev/null | grep -q '^COMMAND' ;;
      *) false ;;
    esac && return 0
  done
  return 1
}

# Print the free space in whole GB of the file system of directory $1, or nothing when it cannot be read.
free_disk_gb() {
  free_kb=$(df -Pk "$1" 2> /dev/null | awk 'NR == 2 { print $4 }')
  case "$free_kb" in
    '' | *[!0-9]*) return 0 ;;
  esac
  printf '%s' $((free_kb / 1048576))
}

# Docker Compose loses track of the image that it builds, in 2.37.0 to 2.38.x (docker/compose#13047) and
# on the containerd image store before 5.4.0 (docker/compose#13636): it then recreates the Airflow
# containers at every start, or gives them an updated image one start late. The stack works, so this
# only warns. $1 is the Compose version, $2 the type of the image store (empty for the classic one).
check_compose_tracks_images() {
  if { version_ge "$1" 2.37.0 && ! version_ge "$1" 2.39.0; } ||
    { [ "$2" = io.containerd.snapshotter.v1 ] && ! version_ge "$1" 5.4.0; }; then
    warn "Docker Compose ${1#v} does not keep track of the Airflow image that it builds: the Airflow containers can restart at every start, or get an updated image only at the next start (docker/compose#13047, docker/compose#13636). Update Docker Compose to 5.4.0 or newer."
  fi
}

cmd_preflight() {
  force=0
  for option in "$@"; do
    case "$option" in
      --force) force=1 ;;
      *) die "unknown option: $option" ;;
    esac
  done
  problems=0
  command -v docker > /dev/null 2>&1 || die "Docker is not installed: see https://docs.docker.com/get-started/get-docker/"
  # The last field is the type of the image store: io.containerd.snapshotter.v1 on the containerd image
  # store, and nothing on the classic one.
  info=$(docker info --format '{{.ServerVersion}}|{{.Architecture}}|{{.NCPU}}|{{.MemTotal}}|{{.DockerRootDir}}|{{range .DriverStatus}}{{if eq (index . 0) "driver-type"}}{{index . 1}}{{end}}{{end}}' 2> /dev/null) || info=""
  if [ -z "${info%%|*}" ]; then
    die "Docker is not running, or this user cannot use it: start Docker Desktop, or on Linux add the user to the docker group"
  fi
  IFS='|' read -r server_version arch ncpu mem_total docker_root image_store << EOF
$info
EOF
  if ! version_ge "$server_version" "$MIN_DOCKER_VERSION"; then
    problem "Docker Engine $server_version is older than $MIN_DOCKER_VERSION: update Docker"
  fi
  # IPv6 on the network of the stack (ADR-0023): Compose reads the setting as a boolean. Docker
  # Engine 27.0.1 is the first that gives an IPv6 network a subnet of its own when none is set
  # (its release notes); server mode needs 28.0.0 anyway.
  case "$(setting AGORANOMOS_IPV6 false)" in
    false) ;;
    true)
      if ! version_ge "$server_version" 27.0.1; then
        problem "AGORANOMOS_IPV6=true in .env needs Docker Engine 27.0.1 or newer, which gives the IPv6 network a subnet of its own: Docker Engine $server_version is older. Update Docker, or set AGORANOMOS_IPV6=false"
      fi
      ;;
    *) problem "AGORANOMOS_IPV6 in .env must be true or false" ;;
  esac
  # Server mode publishes the ports of the proxy on every address of the host, and the tunnels use
  # ports on 127.0.0.1, which Docker before 28.0.0 lets other hosts of the same network segment
  # reach (Docker's documentation, as of October 2026).
  if server_mode; then
    if ! version_ge "$server_version" 28.0.0; then
      problem "Docker Engine $server_version is older than 28.0.0, which server mode needs: before it, other hosts on the same network segment can reach the ports that Docker publishes on 127.0.0.1. Update Docker"
    fi
    site_tls=$(setting AGORANOMOS_TLS acme)
    case "$site_tls" in
      acme | internal) ;;
      *) problem "AGORANOMOS_TLS in .env must be acme or internal" ;;
    esac
    site_url=$(setting AGORANOMOS_SITE_URL "")
    site_host=${site_url#https://}
    if [ "$site_host" = "$site_url" ] || ! valid_domain "$site_host"; then
      problem "server mode needs AGORANOMOS_SITE_URL in .env to be https:// and the domain name of the server, without a port or a path: run ./agoranomos init --server <domain>"
    elif [ "$site_tls" = acme ] && ! public_name "$site_host"; then
      problem "$site_host cannot get a certificate from Let's Encrypt: run ./agoranomos init --server with the domain name of the server, or set AGORANOMOS_TLS=internal in .env for a test"
    fi
  fi
  # Compose reads a value that is not a path, such as backups, as the name of a volume, and stops
  # with an error that names no setting.
  for folder_setting in AGORANOMOS_BACKUP_DIR AGORANOMOS_EXTENSIONS_DIR; do
    if ! is_folder_path "$(setting "$folder_setting" ./folder)"; then
      problem "$folder_setting in .env must be an absolute path or start with ./, ../ or ~/, because Compose reads anything else as the name of a volume: write ./$(setting "$folder_setting" folder)"
    fi
  done
  # The backup service of the ops profile runs as AGORANOMOS_UID and reads its schedule from .env.
  if ops_mode; then
    message=$(backup_user_problem)
    if [ -n "$message" ]; then
      problem "$message"
    elif backup_folder_foreign; then
      if [ "$(uname -s)" = Linux ]; then
        problem "$(backups_folder_unwritable)"
      else
        warn "the backup service runs as UID $(env_get AGORANOMOS_UID) (AGORANOMOS_UID in .env), and the backups folder $owned_folder belongs to UID $folder_owner: Docker Desktop maps the owner of a shared folder, so the service can write there, but a Linux server would not let it"
      fi
    fi
    case "$(setting BACKUP_TIME 03:00)" in
      [01][0-9]:[0-5][0-9] | 2[0-3]:[0-5][0-9]) ;;
      *) problem "BACKUP_TIME in .env must be a time of day as HH:MM, such as 03:00" ;;
    esac
    for keep_setting in BACKUP_KEEP_DAILY BACKUP_KEEP_WEEKLY BACKUP_KEEP_MONTHLY; do
      case "$(setting "$keep_setting" 1)" in
        '' | *[!0-9]*) problem "$keep_setting in .env must be a whole number" ;;
      esac
    done
    # Zeros only, such as 0 or 00: the service reads a number, and stops on it.
    if [ -z "$(setting BACKUP_KEEP_DAILY 7 | tr -d 0)" ]; then
      problem "BACKUP_KEEP_DAILY in .env must be at least 1: the newest backup always stays"
    fi
    # The image of the databases has the time zones of the IANA database, as Linux and macOS
    # have them in /usr/share/zoneinfo: a machine without that folder leaves the check to it.
    backup_tz=$(setting BACKUP_TZ UTC)
    zoneinfo=${AGORANOMOS_ZONEINFO:-/usr/share/zoneinfo}
    if [ "$backup_tz" != UTC ] && [ -d "$zoneinfo" ] && [ ! -f "$zoneinfo/$backup_tz" ]; then
      problem "BACKUP_TZ in .env is not a time zone, such as Europe/Berlin: $backup_tz"
    fi
  elif server_mode; then
    # A .env of server mode from before the backups lists server and not ops, and init changes a
    # list of profiles only with --server.
    backup_domain=$(setting AGORANOMOS_SITE_URL "")
    backup_domain=${backup_domain#https://}
    warn "Server mode runs without the backups of the ops profile: ./agoranomos init --server ${backup_domain:-<domain>} turns them on"
  fi
  # Metabase checks the password of the admin account against its rule when metabase-init creates
  # the account at the first start, and with strong-enough it refuses one of fewer than 15
  # characters. init --server sets that rule, and compose.yaml hands it to Metabase in every mode, so
  # a person can set it in local mode too. init generates a password of 32 characters, so this
  # catches one set by hand. metabase-init never changes the password of an admin that exists, so
  # for a Metabase that is set up already the message sends the person to Metabase first. This
  # check blocks up, so with the stack stopped the message also names the command that starts
  # Metabase alone. The message names the settings, never the value. strong has other rules, and
  # normal, the default, asks for less: they are Metabase's to check.
  admin_password=$(env_get METABASE_ADMIN_PASSWORD)
  if [ "$(setting METABASE_PASSWORD_COMPLEXITY normal)" = strong-enough ] &&
    [ -n "$admin_password" ] && [ "${#admin_password}" -lt 15 ]; then
    problem "METABASE_ADMIN_PASSWORD in .env has fewer than 15 characters, which METABASE_PASSWORD_COMPLEXITY=strong-enough asks for. For a Metabase that is set up already, first change the admin password in Metabase (Account settings) to at least 15 characters (with the stack stopped, docker compose up -d metabase in this folder starts Metabase alone, with the databases it needs and without the proxy, at 127.0.0.1 on METABASE_PORT, which on a server you reach through an SSH tunnel), then put the same value in .env; for a new one, write a longer value, or leave it empty for ./agoranomos init to generate one"
  fi
  compose_version=$(docker compose version --short 2> /dev/null) || compose_version=""
  if [ -z "$compose_version" ]; then
    problem "the Docker Compose plugin is missing: see https://docs.docker.com/compose/install/"
  elif ! version_ge "$compose_version" "$MIN_COMPOSE_VERSION"; then
    problem "Docker Compose ${compose_version#v} is older than $MIN_COMPOSE_VERSION: update Docker Compose"
  else
    check_compose_tracks_images "$compose_version" "$image_store"
  fi
  case "$arch" in
    aarch64 | arm64) ;;
    x86_64 | amd64) check_x86_64_v2 ;;
    *) problem "the CPU architecture $arch is not supported: Agoranomos runs on arm64 and on x86-64 with x86-64-v2" ;;
  esac
  # Where to raise them: Docker Desktop on macOS, Linux and Windows with Hyper-V sets the memory and
  # the CPUs of its VM itself; on Windows with WSL2 it leaves them to WSL, which reads .wslconfig in
  # the Windows user folder when it starts. That file does not exist by default, and wsl --shutdown,
  # which restarts WSL, is a command of Windows (as of October 2026, Docker's and Microsoft's
  # documentation). Docker Engine on Linux has the memory and the CPUs of its machine.
  raise_memory="In Docker Desktop, raise it in Settings → Resources → Advanced → Memory limit; on Windows with WSL2, set memory= in the [wsl2] section of .wslconfig in your Windows user folder (create the file if there is none), then run wsl --shutdown in PowerShell. With Docker Engine on Linux, Docker has the memory of the machine."
  raise_cpus="In Docker Desktop, raise it in Settings → Resources → Advanced → CPU limit; on Windows with WSL2, set processors= in the [wsl2] section of .wslconfig in your Windows user folder (create the file if there is none), then run wsl --shutdown in PowerShell. With Docker Engine on Linux, Docker has the CPUs of the machine."
  # How much memory the variant needs (ADR-0022): the CeleryExecutor variant is the one whose
  # COMPOSE_FILE lists compose.celery.yaml.
  case ":$(setting COMPOSE_FILE compose.yaml):" in
    *compose.celery.yaml:*)
      recommended_mb=$RECOMMENDED_CELERY_MEMORY_MB
      recommended="12 GB for the CeleryExecutor variant"
      memory_needed="6 GB (12 GB recommended for the CeleryExecutor variant)"
      ;;
    *)
      recommended_mb=$RECOMMENDED_MEMORY_MB
      recommended="8 GB"
      memory_needed="6 GB (8 GB recommended)"
      ;;
  esac
  mem_mb=$((mem_total / 1048576))
  if [ "$mem_mb" -lt "$MIN_MEMORY_MB" ]; then
    resource_problem "Docker has $mem_mb MB of memory, and Agoranomos needs $memory_needed. $raise_memory"
  elif [ "$mem_mb" -lt "$recommended_mb" ]; then
    warn "Docker has $mem_mb MB of memory; $recommended is recommended. $raise_memory"
  fi
  if [ "$ncpu" -lt "$MIN_CPUS" ]; then
    resource_problem "Docker has $ncpu CPU, and Agoranomos needs $MIN_CPUS ($RECOMMENDED_CPUS recommended). $raise_cpus"
  elif [ "$ncpu" -lt "$RECOMMENDED_CPUS" ]; then
    warn "Docker has $ncpu CPUs; $RECOMMENDED_CPUS are recommended. $raise_cpus"
  fi
  # On Linux the data of Docker is on this machine; Docker Desktop keeps it inside its VM.
  if [ -d "$docker_root" ]; then
    free_gb=$(free_disk_gb "$docker_root")
    if [ -z "$free_gb" ]; then
      warn "could not read the free disk space for Docker ($docker_root)"
    elif [ "$free_gb" -lt "$MIN_DISK_GB" ]; then
      resource_problem "$free_gb GB of disk is free for Docker ($docker_root), and Agoranomos needs $MIN_DISK_GB GB ($RECOMMENDED_DISK_GB GB recommended). Free up disk space on the file system of $docker_root."
    elif [ "$free_gb" -lt "$RECOMMENDED_DISK_GB" ]; then
      warn "$free_gb GB of disk is free for Docker ($docker_root); $RECOMMENDED_DISK_GB GB is recommended. Free up disk space on the file system of $docker_root."
    fi
  fi
  # Metabase does not start with a session key shorter than 16 characters (compose.yaml). init
  # generates a longer one; this catches one set by hand.
  session_key=$(env_get METABASE_SESSION_KEY)
  if [ -n "$session_key" ] && [ "${#session_key}" -lt 16 ]; then
    problem "METABASE_SESSION_KEY in .env has fewer than 16 characters, and Metabase does not start with it: empty it, and ./agoranomos up generates a new one"
  fi
  # Compose reads a memory limit without a unit as bytes, and Docker then refuses the container
  # with an error that names neither the service nor the setting. A unit of k, m or g, in either
  # case and with b or ib after it, is what Compose reads as KiB, MiB or GiB; empty is the default
  # of compose.yaml. The size must also be at least 6 MiB, the smallest limit that Docker accepts.
  # The message names the setting, never a value.
  # The loop reads a here-document, not a pipe, so that problem counts in this shell.
  if [ -f "$ENV_FILE" ]; then
    memory_settings=$(sed -n 's/^\([A-Za-z0-9_]*_MEMORY\)=.*/\1/p' "$ENV_FILE" | sort -u)
    while IFS= read -r memory_setting; do
      [ -n "$memory_setting" ] || continue
      memory_value=$(env_get "$memory_setting")
      [ -n "$memory_value" ] || continue
      memory_size=$(memory_bytes "$memory_value")
      if [ -z "$memory_size" ]; then
        problem "$memory_setting in .env is not a memory size: write a number with m or g, such as 2048m or 2g, or leave it empty for the default; a number alone would be bytes"
      elif [ "$memory_size" -lt 6291456 ]; then
        problem "$memory_setting in .env is smaller than 6 MiB, the smallest memory limit that Docker accepts: write at least 6m, or leave it empty for the default"
      fi
    done << EOF
$memory_settings
EOF
  fi
  # Compose trims the blanks after the = before it looks for a comment, so in "KEY= # note" the value
  # is "# note", not empty: a comment after an empty value becomes the value, a secret or the session
  # key of Metabase among them, and env_get reads it the same way. A # right after the =, as in
  # KEY=#abc, is a value, and is not reported. The message names the setting, never the value.
  if [ -f "$ENV_FILE" ]; then
    comment_settings=$(awk '/^[A-Za-z0-9_.-]+=[ \t\r\v\f]+#/ { print substr($0, 1, index($0, "=") - 1) }' "$ENV_FILE" | sort -u)
    while IFS= read -r comment_setting; do
      [ -n "$comment_setting" ] || continue
      problem "$comment_setting in .env has a comment after an empty value, which Docker Compose reads as the value: put the comment on a line of its own, and leave the value empty or write one"
    done << EOF
$comment_settings
EOF
  fi
  # A running stack holds its own ports, so the ports are checked only while it is not running.
  if [ -z "$(compose ps --quiet --status running 2> /dev/null)" ]; then
    if [ -n "$(port_tools)" ]; then
      port_settings="AIRFLOW_PORT:8080 METABASE_PORT:3000"
      if server_mode; then port_settings="$port_settings HTTP:80 HTTPS:443"; fi
      for port_setting in $port_settings; do
        name=${port_setting%%:*}
        case "$name" in
          HTTP | HTTPS) port=${port_setting#*:} ;;
          *) port=$(setting "$name" "${port_setting#*:}") ;;
        esac
        if port_in_use "$port"; then
          case "$name" in
            HTTP | HTTPS) problem "port $port is in use: the proxy of server mode needs it. Stop what uses it" ;;
            *) problem "port $port is in use: stop what uses it, or set $name in .env to a free port" ;;
          esac
        fi
      done
    else
      warn "cannot check whether the ports are free: install ss (iproute2), netstat or lsof"
    fi
  fi
  if [ "$problems" -gt 0 ]; then
    die "preflight found $problems problem(s)"
  fi
  say "$(paint ok 'Preflight passed:' 1) Docker $server_version, Compose ${compose_version#v}, $arch, $ncpu CPUs, $mem_mb MB of memory."
}

# Wait until every long-running service is healthy (or running, if it has no health check) and every
# one-shot job (its name ends in -init or -export) has exited with 0. A service that is not ready
# yet is named with what it is doing, as name (state) or name (state, health). Only the services of
# the active profiles count: docker compose ps lists every container of the project, also one that a
# start with another profile left behind, such as a failed demo-init after COMPOSE_PROFILES=core. A
# failed demo-init alone does not stop the wait: the rest of the stack works without the demo, so
# the wait goes on until the rest is ready, and then sets demo_failed=1 for cmd_up. A backup
# service that is unhealthy (no good backup in the last 26 hours), restarting or exited does not
# stop it either: the stack works without a fresh backup, so the wait warns and goes on.
# AGORANOMOS_WAIT_TIMEOUT and AGORANOMOS_WAIT_INTERVAL, in seconds, are hooks for the tests: how long
# to wait at most (default 900) and how long to sleep between two looks (default 5).
# The line that names a service that failed while up waited, and the command that shows its logs.
# Exit code 137 is SIGKILL, which is what the kernel sends at a memory limit: the log of the
# service then ends without an error of its own, so the line says what the code means.
failed_service() {
  case " $killed " in
    *" $1 "*) printf '%s failed: see ./agoranomos logs %s (exit code 137: it was killed, most often because it reached its memory limit)' "$1" "$1" ;;
    *) printf '%s failed: see ./agoranomos logs %s' "$1" "$1" ;;
  esac
}

wait_healthy() {
  demo_failed=0
  timeout=${AGORANOMOS_WAIT_TIMEOUT:-900}
  interval=${AGORANOMOS_WAIT_INTERVAL:-5}
  started=$(date +%s)
  say "Waiting until every service is healthy (at most $timeout seconds)..."
  active=$(compose config --services) ||
    die "docker compose config failed; the error above names the cause"
  active=" $(printf '%s' "$active" | tr '\n' ' ') "
  while :; do
    states=$(compose ps --all --format '{{.Service}}|{{.State}}|{{.Health}}|{{.ExitCode}}') ||
      die "docker compose ps failed; the error above names the cause, and Docker may have stopped"
    pending="" failed="" killed="" seen="" stale_backup=0 backup_down=""
    while IFS='|' read -r service state health exit_code; do
      [ -n "$service" ] || continue
      case "$active" in *" $service "*) ;; *) continue ;; esac
      seen=1
      case "$service" in
        *-init | *-export)
          case "$state:$exit_code" in
            exited:0) ;;
            exited:137) failed="$failed $service" killed="$killed $service" ;;
            exited:* | dead:*) failed="$failed $service" ;;
            *) pending="${pending:+$pending,} $service ($state${health:+, $health})" ;;
          esac
          ;;
        backup)
          # No good backup in the last 26 hours makes the service unhealthy: up says so and goes on,
          # because the stack works without a fresh backup; status shows when the last one was.
          case "$state:$health:$exit_code" in
            running:healthy:* | running::*) ;;
            running:unhealthy:*) stale_backup=1 ;;
            restarting:* | exited:* | dead:*) backup_down="$state${exit_code:+ with exit code $exit_code}" ;;
            *) pending="${pending:+$pending,} $service ($state${health:+, $health})" ;;
          esac
          ;;
        *)
          case "$state:$health:$exit_code" in
            running:healthy:* | running::*) ;;
            exited:*:137) failed="$failed $service" killed="$killed $service" ;;
            running:unhealthy:* | exited:* | dead:*) failed="$failed $service" ;;
            *) pending="${pending:+$pending,} $service ($state${health:+, $health})" ;;
          esac
          ;;
      esac
    done << EOF
$states
EOF
    [ -n "$seen" ] || pending=" (no containers yet)"
    # The failed services other than demo-init: any of them means that the stack did not start.
    others=""
    for service in $failed; do
      [ "$service" = demo-init ] || others="$others $service"
    done
    if [ -n "$others" ]; then
      for service in $failed; do
        warn "$(failed_service "$service")"
      done
      die "the stack did not start"
    fi
    if [ -z "$pending" ]; then
      [ "$stale_backup" -eq 0 ] ||
        warn "backup: $NO_RECENT_BACKUP: ./agoranomos status shows when the last one was, and ./agoranomos logs backup why"
      [ -z "$backup_down" ] ||
        warn "backup: the backup service is $backup_down, so there are no new backups: ./agoranomos logs backup shows why. The stack works without it"
      if [ -n "$failed" ]; then
        warn "$(failed_service demo-init)"
        demo_failed=1
        return 0
      fi
      if [ "$stale_backup" -eq 0 ] && [ -z "$backup_down" ]; then
        say "$(paint ok 'All services are healthy.' 1)"
      else
        say "$(paint ok 'All services but the backup are healthy.' 1)"
      fi
      return 0
    fi
    if [ $(($(date +%s) - started)) -ge "$timeout" ]; then
      [ -z "$failed" ] || warn "$(failed_service demo-init)"
      die "still waiting after $timeout seconds for:$pending (see ./agoranomos status)"
    fi
    sleep "$interval"
  done
}

# Where to reach Airflow and Metabase once the stack is up: on 127.0.0.1 in local mode, and in
# server mode the site, with Airflow on the server only, through an SSH tunnel.
print_addresses() {
  airflow_port=$(setting AIRFLOW_PORT 8080)
  if server_mode; then
    say "$(paint mute 'Airflow:' 1)  $(paint amber "http://127.0.0.1:$airflow_port" 1) on this server; from your machine: ssh -L $airflow_port:127.0.0.1:$airflow_port <user>@<server>"
    say "$(paint mute 'Metabase:' 1) $(paint amber "$(setting AGORANOMOS_SITE_URL '')" 1)"
  else
    say "$(paint mute 'Airflow:' 1)  $(paint amber "http://127.0.0.1:$airflow_port" 1)"
    say "$(paint mute 'Metabase:' 1) $(paint amber "http://127.0.0.1:$(setting METABASE_PORT 3000)" 1)"
  fi
  say "./agoranomos credentials shows how to sign in."
}

# In server mode with a certificate of Let's Encrypt: whether the site answers over HTTPS with a
# certificate that this machine trusts. Caddy gets the certificate after it starts, and only when
# the A record of the domain points at this server and ports 80 and 443 are open to the
# internet, so this tries for about a minute and then only warns: the stack runs either way.
# AGORANOMOS_CERTIFICATE_TRIES is a hook for the tests (default 12, every AGORANOMOS_WAIT_INTERVAL
# seconds).
check_certificate() {
  if ! server_mode || [ "$(setting AGORANOMOS_TLS acme)" != acme ]; then
    return 0
  fi
  site_host=$(setting AGORANOMOS_SITE_URL '')
  site_host=${site_host#https://}
  if ! command -v curl > /dev/null 2>&1; then
    warn "cannot check the certificate of https://$site_host: install curl"
    return 0
  fi
  say "Checking the certificate of https://$site_host, for about a minute."
  tries=${AGORANOMOS_CERTIFICATE_TRIES:-12}
  while [ "$tries" -gt 0 ]; do
    if curl --silent --output /dev/null --max-time 10 --noproxy '*' --resolve "$site_host:443:127.0.0.1" "https://$site_host/api/health"; then
      return 0
    fi
    tries=$((tries - 1))
    [ "$tries" -eq 0 ] || sleep "${AGORANOMOS_WAIT_INTERVAL:-5}"
  done
  warn "https://$site_host does not answer with a certificate that this machine trusts yet. Check that the A record of $site_host points at this server and that ports 80 and 443 are open to the internet; ./agoranomos logs proxy shows what Let's Encrypt answered, and docker compose restart proxy makes Caddy try again at once, without waiting out the pause between its tries. With the staging directory of Let's Encrypt in AGORANOMOS_ACME_CA, no machine trusts the certificate."
}

# docker compose with the profile $1 added to those of .env, for a service of that profile: the
# proxy belongs to server, the backup service to ops.
compose_with_profile() {
  extra_profile=$1
  shift
  compose_status=0
  compose "$@" || compose_status=$?
  extra_profile=""
  return "$compose_status"
}

# Stop and remove the containers that a mode with fewer profiles left. Compose does not touch the
# container of a profile that .env no longer lists. After a person takes server out of
# COMPOSE_PROFILES, the old Caddy would go on serving the new Metabase on ports 80 and 443, with
# the rules of local mode, and after the person takes ops out, the old backup service would go on
# writing backups. The volume caddy-data, with the certificates, and the backups stay. In a mode
# that lists the profile, up and down handle the service as they handle every service.
remove_leftover_services() {
  if ! server_mode; then
    remove_leftover_container proxy server "the proxy of server mode" \
      "Server mode is off: the proxy of server mode is stopped and removed." \
      "which may still serve Metabase on ports 80 and 443 with the rules of local mode"
  fi
  if ! ops_mode; then
    remove_leftover_container backup ops "the backup service of the ops profile" \
      "The ops profile is off: the backup service is stopped and removed." \
      "which may still write backups"
  fi
}

# Stop and remove the container of the service $1 of the profile $2, if there is one. $3 names it,
# $4 is what to say when it is gone, and $5 what it may still do, for the message when it stays.
# The look-up only asks whether there is a container to remove: when it fails, the command that
# follows meets the same fault and says so itself, so the look-up stays silent and goes on.
remove_leftover_container() {
  leftover_container=$(compose_with_profile "$2" ps --all --quiet "$1" 2> /dev/null) ||
    leftover_container=""
  [ -n "$leftover_container" ] || return 0
  compose_with_profile "$2" rm --stop --force "$1" ||
    die "could not remove $3, $5: run docker compose --profile $2 rm --stop --force $1, then run this command again"
  say "$4"
}

# Start the stack, wait until it is healthy, print where to sign in, and in server mode check the
# certificate of the site. It sets demo_failed, as wait_healthy does.
start_stack() {
  # Without the || a failure would end the script under set -e with only the message of docker compose.
  compose up --detach --remove-orphans ||
    die "docker compose could not start the stack; the error above names the cause, and ./agoranomos status and ./agoranomos logs <service> show more"
  wait_healthy
  print_addresses
  check_certificate
}

# The network default of the stack has IPv6 when AGORANOMOS_IPV6 says so, and the label
# dev.agoranomos.ipv6 of compose.yaml carries the same value (ADR-0023). Docker Compose recreates a
# network when anything in its definition changes, also when the network was an implicit one and a
# release declares it, and then it reconnects the containers that it keeps without the aliases of
# their services (execConnectNetwork in pkg/compose/executor_ops.go, the same in Compose 5.5.1 and
# 5.6.0, checked with Compose 5.5.1 of Docker Desktop, October 2026): metabase-init, which is on
# this network only, cannot find Metabase then, and up waits ten minutes and fails. So when the
# network that exists has the other IPv6 setting, or lacks the label (it was made by an earlier
# release) or has another value in it, the stack goes down first, without its volumes, and up makes
# the network and the containers together. COMPOSE_PROJECT_NAME is a valid project name as it
# stands, or Compose stops on it.
stop_for_changed_network() {
  network_state=$(docker network inspect --format '{{.EnableIPv6}}|{{index .Labels "dev.agoranomos.ipv6"}}' "$(setting COMPOSE_PROJECT_NAME agoranomos)_default" 2> /dev/null) ||
    return 0
  network_ipv6=${network_state%%|*} network_label=${network_state#*|}
  wanted_ipv6=$(setting AGORANOMOS_IPV6 false)
  case "$network_ipv6" in true | false) ;; *) return 0 ;; esac
  { [ "$network_ipv6" != "$wanted_ipv6" ] || [ "$network_label" != "$wanted_ipv6" ]; } || return 0
  if [ "$wanted_ipv6" = true ]; then ipv6_state=on; else ipv6_state=off; fi
  say "The network of the stack changes (IPv6 $ipv6_state): stopping the stack first, the data stays."
  compose down --remove-orphans ||
    die "docker compose could not stop the stack to change its network; the error above names the cause"
}

cmd_up() {
  # Check the options before init writes .env: an option that preflight would refuse must not leave
  # a .env behind.
  for option in "$@"; do
    case "$option" in
      --force) ;;
      *) die "unknown option: $option" ;;
    esac
  done
  print_banner
  cmd_init
  cmd_preflight "$@"
  remove_leftover_services
  stop_for_changed_network
  say "Starting the stack. The first start builds the Airflow image, which takes a few minutes..."
  start_stack
  # Only demo-init failed: Airflow and Metabase run, and its log names what to look at in them. up
  # still fails, so that a start that is not complete never passes as one.
  [ "$demo_failed" -eq 0 ] || die "the stack is up, but the demo is not ready"
  say "$(paint ok 'The stack is up.' 1) ./agoranomos status shows every service."
}

cmd_down() {
  [ "$#" -eq 0 ] || die "down takes no options"
  remove_leftover_services
  compose down --remove-orphans
  say "The stack is stopped. Its data stays in the Docker volumes."
}

# The Status column ends in the health of a service, as in Up 5 minutes (healthy). A column of its
# own for {{.Health}} is not possible: as of Compose 5.5.1 (October 2026), a table has no header
# for it and prints <no value>.
cmd_status() {
  [ "$#" -eq 0 ] || die "status takes no options"
  status_table=$(compose ps --all --format 'table {{.Service}}\t{{.State}}\t{{.Status}}')
  [ -z "$status_table" ] || printf '%s\n' "$status_table"
  backup_status
}

# Take a backup now (ADR-0020): in the running backup service when .env has the ops profile and the
# service runs, and in a container of its own otherwise, such as in local mode. The databases must
# run.
cmd_backup() {
  [ "$#" -eq 0 ] || die "backup takes no options"
  [ -f "$ENV_FILE" ] || die "there is no .env yet: run ./agoranomos up first"
  message=$(backup_user_problem)
  [ -z "$message" ] || die "$message"
  if ! running_service warehouse-db || ! running_service platform-db; then
    die "the databases are not running: start the stack with ./agoranomos up"
  fi
  # The folder first: one that does not exist yet would be made for the user who runs this, and
  # then compared with the user of the service.
  make_backups_folder
  if [ "$(uname -s)" = Linux ] && backup_folder_foreign; then
    die "$(backups_folder_unwritable)"
  fi
  # docker compose exec and run pass their standard input to the command in the container, even
  # with -T: a script that is fed to the shell (ssh host bash -s) would lose its next lines to
  # the backup. So the input of both is /dev/null.
  if ops_mode && running_service backup; then
    compose exec -T backup /bin/sh /opt/agoranomos/postgres/backup.sh now < /dev/null ||
      die "the backup failed: the lines above say at which step. The backups folder is $(backups_path)"
  else
    compose run --rm --no-deps -T backup now < /dev/null ||
      die "the backup failed: the lines above say at which step. The backups folder is $(backups_path)"
  fi
}

# The last backups, after the table of the services: when the last good one was, the backups by
# hand with their size and age, and the warnings. The table (status_table) tells whether the backup
# service is unhealthy, so that status asks Compose once. The age of the last good backup is a
# warning only with the ops profile, which promises a backup every day; otherwise status just says
# it, as a person takes backups by hand when they like.
backup_status() {
  backups_folder=$(backups_path)
  latest="$backups_folder/latest.json"
  stale=0
  if printf '%s\n' "$status_table" | awk '$1 == "backup" && /\(unhealthy\)/ { found = 1 } END { exit !found }'; then
    stale=1
  fi
  set -- "$backups_folder"/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z
  if [ -f "$latest" ]; then
    last_ok=$(json_field "$latest" last_ok)
    if [ -n "$last_ok" ]; then
      last_ok_epoch=$(json_field "$latest" last_ok_epoch)
      case "$last_ok_epoch" in '' | *[!0-9]*) last_ok_epoch=0 ;; esac
      age=$(($(date +%s) - last_ok_epoch))
      say "Backups: the last good backup is $last_ok, $((age / 3600)) hours old, in $backups_folder."
      if [ "$age" -gt "$BACKUP_FRESH_SECONDS" ] && ops_mode; then stale=1; fi
    else
      say "Backups: no good backup yet in $backups_folder."
    fi
  elif [ -d "$1" ]; then
    say "Backups: there is no latest.json in $backups_folder, which says when the last good backup was."
  else
    say "Backups: none yet in $backups_folder. ./agoranomos backup takes one."
  fi
  # The room for the next one: the file system of the folder, which by default is the one that
  # holds the data of Docker too. The folder may not exist yet: its first parent that does.
  free_room=$backups_folder
  while [ ! -d "$free_room" ] && [ "$free_room" != / ]; do free_room=$(dirname "$free_room"); done
  free_kb=$(df -Pk "$free_room" 2> /dev/null | awk 'NR == 2 { print $4 }')
  case "$free_kb" in
    '' | *[!0-9]*) ;;
    *)
      if [ "$free_kb" -ge 1048576 ]; then
        say "Free space on the disk of the backups folder: $((free_kb / 1048576)) GB."
      else
        say "Free space on the disk of the backups folder: $((free_kb / 1024)) MB."
      fi
      ;;
  esac
  # The backups by hand, which the retention never removes (ADR-0020): their size and age. They are
  # listed without latest.json too, as they take disk space whether it is there or not.
  listed=0
  for folder in "$@"; do
    [ "$(json_field "$folder/manifest.json" kind)" = manual ] || continue
    if [ "$listed" -eq 0 ]; then
      say "Backups by hand, which the retention never removes; rm -r \"$backups_folder/<name>\" deletes one:"
      listed=1
    fi
    finished=$(json_field "$folder/manifest.json" finished_epoch)
    case "$finished" in
      '' | *[!0-9]*) age_text="of an unknown age" ;;
      *) age_text="$((($(date +%s) - finished) / 86400)) days old" ;;
    esac
    say "  ${folder##*/}: $(du -sk "$folder" | cut -f1) KiB, $age_text"
  done
  if [ "$(json_field "$latest" result)" = failed ]; then
    # The schedule's output is in the logs of the service; a person who took a backup read why on
    # the screen.
    if [ "$(json_field "$latest" kind)" = manual ]; then
      failed_hint="The lines that ./agoranomos backup printed said why."
    else
      failed_hint="./agoranomos logs backup shows why."
    fi
    warn "the last backup, at $(json_field "$latest" attempted), failed at: $(json_field "$latest" step). $failed_hint When the disk is full, every backup fails and the retention removes none: free space, such as by deleting old backups with rm -r \"$backups_folder/<name>\"."
  fi
  if [ "$stale" -eq 1 ]; then
    warn "$NO_RECENT_BACKUP: ./agoranomos logs backup shows why"
  fi
}

# The databases of a backup, in the order in which restore puts them back.
BACKUP_DATABASES="warehouse airflow metabase"

# The service of the database $1.
database_service() {
  case "$1" in
    warehouse) printf 'warehouse-db' ;;
    *) printf 'platform-db' ;;
  esac
}

# The images that the database $1 depends on: PostgreSQL, which made its dump, and the application
# that migrated it, which reads it after a restore.
database_images() {
  case "$1" in
    warehouse) printf 'postgres' ;;
    airflow) printf 'postgres apache/airflow' ;;
    metabase) printf 'postgres metabase/metabase' ;;
  esac
}

# The version of each image of the repository $2 in the list of references $1, one to a line:
# the name and the tag, without the digest, which changes with every rebuild of the same version.
# Of PostgreSQL the major version alone, such as postgres:18: a minor update keeps the format of
# the data, and pg_restore reads the dump, while a new major version is an upgrade of its own.
image_tags() {
  printf '%s\n' "$1" | tr ' ' '\n' | sed -n "s|^\($2:[^@]*\).*|\1|p" |
    if [ "$2" = postgres ]; then sed 's|^\(postgres:[0-9]*\).*|\1|'; else cat; fi |
    LC_ALL=C sort -u
}

# Remove the dump that restore copied into a container, if it is still there. It holds a whole
# database, so a failure to remove it is a warning with the command to do it by hand.
restore_remove_dump() {
  if [ -n "$restore_dump" ]; then
    compose exec -T "$restore_dump_service" rm -f "$restore_dump" < /dev/null ||
      warn "could not remove $restore_dump in $restore_dump_service, which holds a copy of a database: remove it by hand with docker compose exec $restore_dump_service rm -f $restore_dump"
    restore_dump=""
  fi
}

# What a restore says when it ends in an error after it began to change things: which databases
# are back and which are not, that the services are stopped, and what to do. restore_phase says how
# far it got: "" before the stop, then stopping (the stop may be half done), stopped, restoring,
# restored (the databases are back, the stack is starting) and started. restore_unsure is the
# database whose pg_restore did not end well, which may be incomplete.
restore_report() {
  restore_pending=""
  for restore_database in $databases; do
    case " $restored " in
      *" $restore_database "*) ;;
      *) restore_pending="${restore_pending:+$restore_pending }$restore_database" ;;
    esac
  done
  restore_again="./agoranomos restore $restore_name --only $(printf '%s' "$restore_pending" | tr ' ' ',')"
  case "$restore_phase" in
    stopping)
      error_line "restore stopped before it changed a database: ${restore_pending} are as they were. Some of the services that use the databases may be stopped: ./agoranomos up starts the stack again as it was"
      ;;
    stopped | restoring)
      if [ -n "$restore_unsure" ]; then
        restore_hint=""
        if [ "$restore_interrupted" -eq 1 ]; then
          restore_hint=" pg_restore may still run in $(database_service "$restore_unsure"): until it has ended, a new restore stops with 'being accessed by other users' and changes nothing."
        fi
        error_line "restore stopped. Restored from $restore_name: ${restored:-none}. $restore_unsure was being restored and may be incomplete. Not restored: $restore_pending. The services that use the databases are stopped.$restore_hint Do not run ./agoranomos up, which would start the stack on it: run $restore_again again first"
      elif [ -z "$restored" ]; then
        error_line "restore stopped. Restored from $restore_name: none; $restore_pending are as they were. The services that use the databases are stopped: ./agoranomos up starts the stack again as it was, or run $restore_again again"
      else
        error_line "restore stopped. Restored from $restore_name: $restored. Not restored: $restore_pending, which are as they were. The services that use the databases are stopped, and ./agoranomos up would start the stack on databases from two different times: finish with $restore_again first"
      fi
      ;;
    restored)
      error_line "restore stopped. Restored from $restore_name: $restored, all of them; the stack did not come up. ./agoranomos status and ./agoranomos logs <service> show why, and ./agoranomos up starts it again"
      ;;
  esac
}

# The trap of EXIT once restore has begun to stop services: whatever ended it, it removes the dump
# that it left in a container and says where it stopped.
restore_exit() {
  restore_code=$?
  trap - EXIT INT TERM HUP
  restore_remove_dump
  if [ "$restore_code" -ne 0 ]; then
    restore_report
  fi
  exit "$restore_code"
}

# The trap of INT, TERM and HUP (a dropped SSH session): end the restore, which runs the trap of
# EXIT.
restore_signaled() {
  restore_interrupted=1
  error_line "restore was interrupted"
  exit "$1"
}

# Put databases back as a backup has them (ADR-0020). Nothing changes until the backup has passed
# its check in the backup service, the images of its databases match those of the checkout, and
# the person has said yes; then it removes what a mode left behind, stops every service but the
# databases, runs db-init, restores each database as its superuser inside its container, through
# the socket, where the image trusts it, and starts the stack. The dump goes into the /tmp of the
# container first, so that pg_restore reads a file. From the stop on, a failure or an interrupt
# says which databases are back, that the services are stopped, and what to do (restore_exit).
cmd_restore() {
  restore_name="" restore_only="" restore_only_given=0 restore_force=0 restore_yes=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --only)
        # An empty list must not fall back to every database, and a second one must not replace
        # the first without a word.
        { [ "$#" -ge 2 ] && [ -n "$2" ]; } ||
          die "--only needs the databases to restore, such as --only metabase or --only warehouse,airflow"
        [ "$restore_only_given" -eq 0 ] ||
          die "--only is given once: list the databases in one list, such as --only warehouse,airflow"
        restore_only=$2 restore_only_given=1
        shift 2
        ;;
      --yes)
        restore_yes=1
        shift
        ;;
      --force)
        restore_force=1
        shift
        ;;
      -*) die "unknown option of restore: $1" ;;
      *)
        [ -z "$restore_name" ] || die "restore takes one backup"
        restore_name=$1
        shift
        ;;
    esac
  done
  [ -n "$restore_name" ] || die "usage: ./agoranomos restore <backup> [--only <databases>] [--yes] [--force]; ./agoranomos status names the last backup"
  [ -f "$ENV_FILE" ] || die "there is no .env: restore with the .env of the deployment that took the backup, whose keys decrypt the connections that Airflow and Metabase saved"
  root=$(backups_path)
  if [ "$restore_name" = latest ]; then
    restore_name=$(json_field "$root/latest.json" last_ok)
    [ -n "$restore_name" ] || die "there is no good backup in $root yet"
  fi
  case "$restore_name" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z) ;;
    *) die "not the name of a backup: $restore_name. The names are those of the folders in $root, such as 20261011T030012Z" ;;
  esac
  folder="$root/$restore_name"
  [ -f "$folder/manifest.json" ] || die "there is no complete backup $restore_name in $root"
  wanted=$(printf '%s' "${restore_only:-$BACKUP_DATABASES}" | tr ',' ' ')
  for database in $wanted; do
    case " $BACKUP_DATABASES " in
      *" $database "*) ;;
      *) die "not a database of a backup: $database (warehouse, airflow or metabase)" ;;
    esac
  done
  # The databases once each, in the order of a backup, whatever the order of the list.
  databases=""
  for database in $BACKUP_DATABASES; do
    case " $wanted " in
      *" $database "*) databases="${databases:+$databases }$database" ;;
    esac
  done
  [ -n "$databases" ] || die "--only needs the databases to restore, such as --only metabase or --only warehouse,airflow"
  if [ "$restore_yes" -eq 0 ] && [ ! -t 0 ]; then
    die "restore replaces databases: run it in a terminal, which asks first, or pass --yes"
  fi
  message=$(backup_user_problem)
  [ -z "$message" ] || die "$message"
  # The checks of up, also on a new server: Docker, the memory, the disk and the ports. They run
  # without --force, which here is about the images: a machine on which up needs --force stops here.
  cmd_preflight
  # As backup does, in every mode: the check runs as AGORANOMOS_UID, and on Linux it cannot enter
  # a folder of mode 700 that another user owns.
  if [ "$(uname -s)" = Linux ] && backup_folder_foreign; then
    die "$(backups_folder_unwritable)"
  fi
  say "Checking the backup $restore_name..."
  # In the running backup service when there is one, as backup does: a container more would add
  # its limit to the sum that the memory budget holds. Either way it runs as AGORANOMOS_UID. A
  # service that was made before a change of the folder or the user in .env checks another folder
  # than the one that restore copies from: then a container of its own with the current mount
  # checks, for the length of the check (a rare case, so the budget of ADR-0022 holds).
  check_in_service=0
  if ops_mode && running_service backup; then
    if backup_service_current; then
      check_in_service=1
    else
      say "The backup service has another backups folder or user than .env names now (./agoranomos up makes it again): checking in a container of its own."
    fi
  fi
  # Neither call reads the standard input of restore, as in cmd_backup.
  if [ "$check_in_service" -eq 1 ]; then
    # shellcheck disable=SC2086 # one argument for each database
    compose exec -T backup /bin/sh /opt/agoranomos/postgres/backup.sh verify "$restore_name" $databases < /dev/null ||
      die "the backup $restore_name did not pass its check (the lines above say why), and nothing was changed"
  else
    # shellcheck disable=SC2086 # one argument for each database
    compose run --rm --no-deps -T backup verify "$restore_name" $databases < /dev/null ||
      die "the backup $restore_name did not pass its check (the lines above say why), and nothing was changed"
  fi
  recorded=$(json_field "$folder/manifest.json" images)
  if [ -z "$recorded" ]; then
    warn "the backup $restore_name does not record the images that took it: check that this checkout is the release that took it"
  else
    current=$(image_refs | tr '\n' ' ')
    differences=""
    for database in $databases; do
      for repository in $(database_images "$database"); do
        was=$(image_tags "$recorded" "$repository" | tr '\n' ' ')
        now=$(image_tags "$current" "$repository" | tr '\n' ' ')
        was=${was% } now=${now% }
        if [ "$was" != "$now" ]; then
          differences="$differences
  $repository: the backup has ${was:-none}, this checkout ${now:-none}"
        fi
      done
    done
    if [ -n "$differences" ]; then
      differences=$(printf '%s\n' "$differences" | LC_ALL=C sort -u)
      if [ "$restore_force" -eq 0 ]; then
        die "the backup $restore_name was taken with other images than this checkout has:$differences
Check out the release that took it and restore there, or pass --force if you know that these versions read it. Nothing was changed."
      fi
      warn "the backup $restore_name was made with other images (--force):$differences"
    fi
  fi
  if [ "$restore_yes" -eq 0 ]; then
    # To standard error, so that the question is seen when the output goes to a file.
    printf 'Restore %s from %s? What they saved after it is lost. Type yes to go on: ' "$databases" "$restore_name" >&2
    read -r answer || answer=""
    [ "$answer" = yes ] || die "nothing was changed"
  fi
  # From here the restore changes things. What a mode left behind goes, as in up: no proxy or
  # backup service of a profile that .env no longer lists runs through a restore.
  remove_leftover_services
  services=$(compose config --services) || die "docker compose config failed; the error above names the cause"
  stop=""
  for service in $services; do
    case "$service" in
      warehouse-db | platform-db) ;;
      *) stop="$stop $service" ;;
    esac
  done
  restored="" restore_phase=stopping restore_dump="" restore_dump_service="" restore_unsure="" restore_interrupted=0
  trap restore_exit EXIT
  trap 'restore_signaled 130' INT
  trap 'restore_signaled 143' TERM
  trap 'restore_signaled 129' HUP
  say "Stopping the services that use the databases..."
  # docker compose stop with no service stops every one, the databases among them.
  if [ -n "$stop" ]; then
    # shellcheck disable=SC2086 # one argument for each service
    compose stop $stop || die "docker compose could not stop the services"
  fi
  restore_phase=stopped
  compose up --detach --wait warehouse-db platform-db ||
    die "the databases did not start: see ./agoranomos logs warehouse-db and ./agoranomos logs platform-db"
  compose run --rm --no-deps -T db-init < /dev/null || die "db-init failed: the lines above say why"
  restore_phase=restoring
  for database in $databases; do
    service=$(database_service "$database")
    dump=/tmp/agoranomos-restore-$database.dump
    say "Restoring $database..."
    restore_dump=$dump restore_dump_service=$service
    # A failure from here to the next restore_remove_dump ends the script, and restore_exit removes
    # the dump.
    if ! compose exec -T "$service" sh -c "umask 077 && cat > $dump" < "$folder/$database.dump"; then
      die "could not copy $database.dump into $service, and $database is as it was"
    fi
    restore_unsure=$database
    if ! compose exec -T "$service" pg_restore --username=postgres --dbname=postgres --clean --if-exists --create --exit-on-error "$dump" < /dev/null; then
      die "pg_restore failed for $database. If it says that the database is being accessed by other users, $database was not changed: stop what is connected and run restore again. After another error $database can be incomplete"
    fi
    restore_remove_dump
    restore_unsure=""
    restored="${restored:+$restored }$database"
    compose exec -T "$service" vacuumdb --username=postgres --analyze-only --quiet --dbname="$database" < /dev/null ||
      warn "ANALYZE of $database failed: it is restored, and its first queries may be slow"
  done
  restore_phase=restored
  say "Restored $databases from $restore_name. The backup also holds extensions.tar.gz, which restore leaves as it is. Starting the stack..."
  start_stack
  restore_phase=started
  trap - EXIT INT TERM HUP
  [ "$demo_failed" -eq 0 ] || die "the databases are restored and the stack is up, but the demo is not ready"
  say "$(paint ok 'The stack is up.' 1) ./agoranomos status shows every service."
}

cmd_logs() {
  if [ "$#" -eq 0 ]; then
    compose logs --tail=200
  else
    compose logs "$@"
  fi
}

# True when the container of Metabase runs and is healthy.
metabase_is_up() {
  compose ps --all --format '{{.Service}}|{{.State}}|{{.Health}}|{{.ExitCode}}' 2> /dev/null |
    grep -q '^metabase|running|healthy|'
}

# Stop the dry run with 2, the code of a check that could not run: a failure of metadata diff never
# looks like the 1 of a plan that is not empty.
check_failed() {
  error_line "$*"
  exit 2
}

# The dry run of the metadata of the marts: metabase-init, in a container of its own, prints what it
# would change in Metabase, and changes nothing. It exits with 0 when Metabase shows what the code
# says, with 1 when the plan is not empty, and with 2 when the check could not run.
cmd_metadata() {
  if [ "$#" -ne 1 ] || [ "$1" != diff ]; then
    check_failed "usage: ./agoranomos metadata diff"
  fi
  metabase_is_up || check_failed "Metabase is not running: start the stack with ./agoranomos up"
  # The job answers 0, 3 for a plan to apply, or 2. docker compose run exits with 1 when it fails
  # itself (Compose 5.5.1), so the job keeps 1 out of its answers, and any code that it does not
  # give is a check that could not run.
  code=0
  compose run --rm --no-deps -T metabase-init \
    python /opt/agoranomos/metabase/metabase_init.py diff < /dev/null || code=$?
  case "$code" in
    0 | 2) exit "$code" ;;
    3) exit 1 ;;
    *) check_failed "the dry run did not finish (exit code $code); the error above names the cause" ;;
  esac
}

# Where to sign in, and as whom. The passwords stay in .env: this prints the names of their
# settings, never their values, so that no password lands in the scrollback of a terminal, in a
# log or on a shared screen.
cmd_credentials() {
  [ "$#" -eq 0 ] || die "credentials takes no options"
  [ -f "$ENV_FILE" ] || die "there is no .env yet: run ./agoranomos init"
  if server_mode; then
    say "Airflow:  http://127.0.0.1:$(setting AIRFLOW_PORT 8080) through an SSH tunnel  user name admin, password AIRFLOW_ADMIN_PASSWORD"
    say "Metabase: $(setting AGORANOMOS_SITE_URL '')  email $(setting AGORANOMOS_ADMIN_EMAIL admin@example.com), password METABASE_ADMIN_PASSWORD"
  else
    say "Airflow:  http://127.0.0.1:$(setting AIRFLOW_PORT 8080)  user name admin, password AIRFLOW_ADMIN_PASSWORD"
    say "Metabase: http://127.0.0.1:$(setting METABASE_PORT 3000)  email $(setting AGORANOMOS_ADMIN_EMAIL admin@example.com), password METABASE_ADMIN_PASSWORD"
  fi
  say "The passwords are the values of these settings in $ENV_FILE, which only you can read."
}

cmd_help() {
  print_banner
  usage
}

usage() {
  cat << 'EOF'
Usage: ./agoranomos <command> [options]

Commands:
  init          Create .env from .env.example and generate the secrets that are empty (--server <domain>: turn server mode on)
  preflight     Check that this machine can run the stack (--force: warn about low resources instead of stopping)
  up            Run init and preflight, start the stack and wait until it is healthy (--force as for preflight)
  down          Stop the stack; the data stays in its Docker volumes
  status        Show the state and health of every service, and the last backups
  backup        Take a backup of the databases now, into the backups folder
  restore       restore <backup>: put the databases back as a backup has them (--only, --yes, --force)
  logs          Show the logs: the last 200 lines, or pass options and services to docker compose logs
  metadata      metadata diff: show what up would change in the metadata of the marts in Metabase
  credentials   Show where to sign in to Airflow and Metabase, and where the passwords are
  help          Show this help

Documentation: docs/reference/command-line.md
EOF
}

main() {
  detect_colors
  command=${1:-help}
  if [ "$#" -gt 0 ]; then shift; fi
  case "$command" in
    init) cmd_init "$@" ;;
    preflight) cmd_preflight "$@" ;;
    up) cmd_up "$@" ;;
    down) cmd_down "$@" ;;
    status) cmd_status "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    logs) cmd_logs "$@" ;;
    metadata) cmd_metadata "$@" ;;
    credentials) cmd_credentials "$@" ;;
    help | -h | --help) cmd_help ;;
    *)
      usage >&2
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
