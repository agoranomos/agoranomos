# The proxy of server mode (ADR-0019): HTTPS for Metabase at AGORANOMOS_SITE_URL, and nothing
# else. Caddy redirects HTTP to HTTPS and gets the certificate itself, from the ACME directory
# AGORANOMOS_ACME_CA (Let's Encrypt), or from its own authority with AGORANOMOS_TLS=internal: the
# command of the proxy in compose.yaml then sets CADDY_TLS to "tls internal". Caddy substitutes
# the {$...} variables before it reads the file, and an empty one leaves an empty line.
{
	# No admin API and no saved configuration: the configuration is this file, read at the start.
	admin off
	persist_config off
	# The root of the own authority of Caddy stays out of the trust store of the container.
	skip_install_trust
	acme_ca {$AGORANOMOS_ACME_CA}
	# TCP only, no HTTP/3: ports 80 and 443 over TCP are all that server mode opens.
	servers {
		protocols h1 h2
	}
}

{$AGORANOMOS_SITE_URL} {
	{$CADDY_TLS}

	# Until its first user exists, Metabase hands its setup token to anyone, and the token creates
	# the first admin. metabase-init sets Metabase up through the network of the stack, so the setup
	# API stays closed here, also later: an empty application database would hand out a token again.
	# The matcher is a prefix, so it closes every path that begins with /api/setup, in whatever
	# spelling (a trailing dot, an escaped space, ;x=1): none of them reaches the router of Metabase.
	@setup path /api/setup*
	respond @setup 404

	# Two endpoints of Metabase 0.63 and 0.64 that forward what they get to servers of Metabase on
	# the internet, with no sign-in, whatever the settings say (ADR-0021). Prefixes again.
	@relays path /api/analytics-proxy* /api/product-feedback*
	respond @relays 404

	# The registration of the OAuth clients of the MCP server of Metabase (ADR-0031): anyone could
	# register one with no sign-in, under any name, with any address to return to and with mb:full.
	# ./agoranomos ai connect registers the clients through the network of the stack, so the path
	# stays closed here, also /oauth/register/<client ID>, where Metabase shows a client its
	# registration. A prefix again.
	@register path /oauth/register*
	respond @register 404

	# An OAuth token reaches only the MCP server (ADR-0031). Metabase 0.64.1 takes a token only from
	# the Authorization header, and its UI signs in with a cookie and sends no such header, so a
	# request that carries one is refused on every path but /api/mcp, exactly: a token with mb:full,
	# which reaches the whole REST API of Metabase, reaches nothing else through the proxy. A public
	# client, which has no secret, gets its tokens at /oauth/token; one that sends its secret in that
	# header does not. The * matches the header with any value, and only when it is there
	# (matchHeaders in modules/caddyhttp/matchers.go of Caddy 2.11.7).
	@token {
		header Authorization *
		not path /api/mcp
	}
	respond @token 403

	# Metabase sets its own security headers, such as its Content-Security-Policy and
	# X-Frame-Options. These fill in only what a response lacks (the ? prefix), for the answers of
	# Metabase and of this file alike. One directive for each header: Caddy applies the defaults of
	# one header block only when the response lacks all of them (as of Caddy 2.11.7, October 2026),
	# and Metabase sends two of the three.
	header ?Strict-Transport-Security "max-age=31536000"
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "strict-origin-when-cross-origin"

	reverse_proxy metabase:3000
}
